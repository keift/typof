{
  "name": "typof",
  "version": "1.1.5",
  "description": "Infer types.",
  "license": "MIT",
  "homepage": "https://github.com/keift/typof",
  "repository": "https://github.com/keift/typof",
  "scripts": {
    "tests": "bun run lint && bun test",
    "retouch": "bun run prettier",
    "build": "tsdown",
    "lint": "eslint ./",
    "prettier": "prettier --write ./"
  },
  "exports": {
    ".": {
      "import": "./dist/main.mjs",
      "types": "./dist/main.d.mts"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "types": "./dist/types.d.mts"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "prettier": "latest",
    "rulint": "latest",
    "tsdown": "latest",
    "unrun": "latest"
  },
  "keywords": [
    "type",
    "types",
    "typeof",
    "string",
    "number",
    "integer",
    "float",
    "boolean",
    "date",
    "object",
    "array"
  ]
}
